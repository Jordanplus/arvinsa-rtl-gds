From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: arvinsa-rtl-gds <noreply@invalid>
Date: Thu, 8 Oct 2026 21:54:06 +0800
Subject: [PATCH] sky130 port_data: precharge the sense amp inputs (column mux
 outputs)

With only an NMOS column mux, the sense amp's internal nodes are restored only
to VDD - Vt between reads; at low temperature or ss low voltage the sense amp
keeps the previous read. Add a precharge_array at the column mux outputs, one
cell per data bit at the sense amp position, enabled by p_en_bar like the
bitline precharge. precharge_array gets mirror_stride for the left/right
mirroring of cells placed every words_per_row columns; the bank connects every
p_en_bar pin of port_data. Not used without a column mux or with spare columns.
(arvinsa-rtl-gds ADR-0018 decision 8)
---
 compiler/modules/bank.py            |  5 ++-
 compiler/modules/port_data.py       | 62 +++++++++++++++++++++++++++--
 compiler/modules/precharge_array.py |  8 +++-
 3 files changed, 67 insertions(+), 8 deletions(-)

diff --git a/compiler/modules/bank.py b/compiler/modules/bank.py
index 42fd96d3..b749b365 100644
--- a/compiler/modules/bank.py
+++ b/compiler/modules/bank.py
@@ -1082,8 +1082,9 @@ class bank(design):
         # Connection from the central bus to the main control block crosses
         # pre-decoder and this connection is in metal3
         connection = []
-        connection.append((self.prefix + "p_en_bar{}".format(port),
-                           self.port_data_inst[port].get_pin("p_en_bar")))
+        # port_data has two p_en_bar pins when it has a precharge array at the sense amp inputs
+        for pin in self.port_data_inst[port].get_pins("p_en_bar"):
+            connection.append((self.prefix + "p_en_bar{}".format(port), pin))
 
         if port in self.write_ports:
             connection.append((self.prefix + "w_en{}".format(port),
diff --git a/compiler/modules/port_data.py b/compiler/modules/port_data.py
index aa39256a..6f887043 100644
--- a/compiler/modules/port_data.py
+++ b/compiler/modules/port_data.py
@@ -107,6 +107,11 @@ class port_data(design):
         else:
             self.column_mux_array_inst = None
 
