     def create_layout(self):
         self.compute_instance_offsets()
         self.place_instances()
@@ -243,6 +248,21 @@ class port_data(design):
         else:
             self.column_mux_array = None
 
+        # A second precharge array at the column mux outputs (the sense amp inputs), one cell per data bit at
+        # the sense amp's position. With only an NMOS column mux the sense amp's internal nodes are restored
+        # only to VDD - Vt between reads, and at low temperature or ss low voltage the sense amp keeps the
+        # previous read (arvinsa-rtl-gds ADR-0010, ADR-0018 decision 8). Not with spare columns (not needed).
+        if self.col_addr_size > 0 and self.port in self.read_ports and not self.num_spare_cols:
+            self.sense_precharge_array = factory.create(module_type="precharge_array",
+                                                        columns=self.word_size,
+                                                        offsets=[self.bit_offsets[b * self.words_per_row]
+                                                                 for b in range(self.word_size)],
+                                                        bitcell_bl=self.bl_names[self.port],
+                                                        bitcell_br=self.br_names[self.port],
+                                                        mirror_stride=self.words_per_row)
+        else:
+            self.sense_precharge_array = None
+
         if self.port in self.write_ports:
             # RBLs dont get a write driver
             self.write_driver_array = factory.create(module_type="write_driver_array",
@@ -342,6 +362,20 @@ class port_data(design):
         temp.append("gnd")
         self.connect_inst(temp)
 
+    def create_sense_precharge_array(self):
+        """ Precharge of the sense amp inputs (bl_out/br_out), same enable as the bitline precharge """
+        self.sense_precharge_array_inst = self.add_inst(name="sense_precharge_array{}".format(self.port),
+                                                        mod=self.sense_precharge_array)
+        temp = []
+        for bit in range(self.word_size):
+            temp.append("bl_out_{0}".format(bit))
+            temp.append("br_out_{0}".format(bit))
+        temp.extend(["p_en_bar", "vdd"])
+        self.connect_inst(temp)
+
+    def place_sense_precharge_array(self, offset):
+        self.sense_precharge_array_inst.place(offset=offset, mirror="MX")
+
     def place_column_mux_array(self, offset):
         """ Placing Column Mux when words_per_row > 1 . """
         if self.col_addr_size == 0:
@@ -443,11 +477,12 @@ class port_data(design):
         vertical_port_order = []
         vertical_port_order.append(self.precharge_array_inst)
