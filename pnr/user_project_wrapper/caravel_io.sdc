# Boundary constraints of user_project_wrapper inside Caravel (ADR-0019 decision 14), sourced by pnr.sdc
# and signoff.sdc after base.sdc. The numbers are the "Retrieved Constraints" of the official wrapper SDC,
# caravel_user_project openlane/user_project_wrapper/signoff.sdc (generated by get_cup_sdc.py 2023-06-20
# from the Caravel STA; caravel_user_project b510613), for the wb_clk_i clock. Not taken from it:
#   - the multicycle paths through wbs_ack_o / wbs_cyc_i / wbs_stb_i (user 2026-10-12: the Wishbone host
#     bridge samples in the first cycle, so every path must close in one cycle; they would not raise the
#     clock either, the limit is the SRAM half-cycle read);
#   - its clock uncertainty, derate, max transition and fanout (clock_uncertainty.sdc and base.sdc);
#   - IO_SYNC = 0 for io_in / io_out / io_oeb: they keep base.sdc's 20 % delay so that no GPIO path is
#     left unconstrained (uart_rx has a 2-flop synchronizer, boot_mode is a strap read as it is).
set cio_clk [get_clocks $::clock_port]

# Clock source latency (Caravel clock tree up to the wrapper pin) and the transition at the pin.
set_clock_latency -source -max 5.57 $cio_clk
set_clock_latency -source -min 4.65 $cio_clk
set_input_transition 0.61 [get_ports $::clock_port]

# wb_rst_i has no Caravel transition: base.sdc's driving cell (caravel_base.sdc leaves it out for all ports).
set_driving_cell -lib_cell [lindex [split $::env(SYNTH_DRIVING_CELL) "/"] 0] \
    -pin [lindex [split $::env(SYNTH_DRIVING_CELL) "/"] 1] [get_ports {wb_rst_i}]

# Reset: generated by the management SoC on wb_clk_i, half a period (as the official SDC).
set_input_delay [expr {$::env(CLOCK_PERIOD) * 0.5}] -clock $cio_clk [get_ports {wb_rst_i}]

# Input delays (replace base.sdc's 20 % for these ports).
set_input_delay -max 1.87 -clock $cio_clk [get_ports {la_data_in[*]}]
set_input_delay -max 1.89 -clock $cio_clk [get_ports {la_oenb[*]}]
set_input_delay -max 3.17 -clock $cio_clk [get_ports {wbs_sel_i[*]}]
set_input_delay -max 3.74 -clock $cio_clk [get_ports {wbs_we_i}]
set_input_delay -max 3.89 -clock $cio_clk [get_ports {wbs_adr_i[*]}]
set_input_delay -max 4.13 -clock $cio_clk [get_ports {wbs_stb_i}]
set_input_delay -max 4.61 -clock $cio_clk [get_ports {wbs_dat_i[*]}]
set_input_delay -max 4.74 -clock $cio_clk [get_ports {wbs_cyc_i}]
set_input_delay -min 0.18 -clock $cio_clk [get_ports {la_data_in[*]}]
set_input_delay -min 0.3  -clock $cio_clk [get_ports {la_oenb[*]}]
set_input_delay -min 0.79 -clock $cio_clk [get_ports {wbs_adr_i[*]}]
set_input_delay -min 1.04 -clock $cio_clk [get_ports {wbs_dat_i[*]}]
set_input_delay -min 1.19 -clock $cio_clk [get_ports {wbs_sel_i[*]}]
set_input_delay -min 1.65 -clock $cio_clk [get_ports {wbs_we_i}]
set_input_delay -min 1.69 -clock $cio_clk [get_ports {wbs_cyc_i}]
set_input_delay -min 1.86 -clock $cio_clk [get_ports {wbs_stb_i}]

# Input transitions (OpenSTA ignores them on a port with a driving cell: caravel_base.sdc).
set_input_transition -max 0.14 [get_ports {wbs_we_i}]
set_input_transition -max 0.15 [get_ports {wbs_stb_i}]
set_input_transition -max 0.17 [get_ports {wbs_cyc_i}]
set_input_transition -max 0.18 [get_ports {wbs_sel_i[*]}]
set_input_transition -max 0.38 [get_ports {io_in[*]}]
set_input_transition -max 0.84 [get_ports {wbs_dat_i[*]}]
set_input_transition -max 0.86 [get_ports {la_data_in[*]}]
set_input_transition -max 0.92 [get_ports {wbs_adr_i[*]}]
set_input_transition -max 0.97 [get_ports {la_oenb[*]}]
set_input_transition -min 0.05 [get_ports {io_in[*]}]
set_input_transition -min 0.06 [get_ports {la_oenb[*]}]
set_input_transition -min 0.07 [get_ports {la_data_in[*]}]
set_input_transition -min 0.07 [get_ports {wbs_adr_i[*]}]
set_input_transition -min 0.07 [get_ports {wbs_dat_i[*]}]
set_input_transition -min 0.09 [get_ports {wbs_cyc_i}]
set_input_transition -min 0.09 [get_ports {wbs_sel_i[*]}]
set_input_transition -min 0.09 [get_ports {wbs_we_i}]
set_input_transition -min 0.15 [get_ports {wbs_stb_i}]

# Output delays (replace base.sdc's 20 % for these ports).
set_output_delay -max 0.7  -clock $cio_clk [get_ports {user_irq[*]}]
set_output_delay -max 1.0  -clock $cio_clk [get_ports {la_data_out[*]}]
set_output_delay -max 3.62 -clock $cio_clk [get_ports {wbs_dat_o[*]}]
set_output_delay -max 8.41 -clock $cio_clk [get_ports {wbs_ack_o}]
set_output_delay -min 0    -clock $cio_clk [get_ports {la_data_out[*]}]
set_output_delay -min 0    -clock $cio_clk [get_ports {user_irq[*]}]
set_output_delay -min 1.13 -clock $cio_clk [get_ports {wbs_dat_o[*]}]
set_output_delay -min 1.37 -clock $cio_clk [get_ports {wbs_ack_o}]

# Output load.
set_load 0.19 [all_outputs]
puts "caravel_io.sdc: Caravel boundary constraints (source latency 4.65-5.57 ns, clock pin transition 0.61 ns, Wishbone/LA delays, load 0.19 pF)"
